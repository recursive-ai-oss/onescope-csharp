<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(OneScopePackagePrefix).Probe</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).Probe</RootNamespace>
    <PackageId>$(OneScopePackagePrefix).Probe</PackageId>
    <Description>A probe a host program calls to stream a library's replay records to a viewer. BCL only; costs one branch per call when nothing is connected.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <!-- Every pack is checked against the last published release, so a binary break for a module built on it fails the pack
       instead of being found at load time. The baseline is restored from nuget.org. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
