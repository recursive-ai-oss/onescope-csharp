<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(OneScopePackagePrefix).Sdk</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).Sdk</RootNamespace>
    <PackageId>$(OneScopePackagePrefix).Sdk</PackageId>
    <Description>The module contract for onescope: worlds, time and history, a neutral draw list, timeline tracks, pokes and findings. BCL only.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Every pack is checked against the first preview, so a binary break for a module built on it is listed (and justified in
       CompatibilitySuppressions.xml) rather than found at load time. The baseline comes from the local feed in ONESCOPE_FEEDS. -->
  <PropertyGroup Condition="'$(ONESCOPE_FEEDS)' != ''">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.1</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
