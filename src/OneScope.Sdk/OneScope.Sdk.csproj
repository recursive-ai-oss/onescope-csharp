<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(OneScopePackagePrefix).Sdk</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).Sdk</RootNamespace>
    <PackageId>$(OneScopePackagePrefix).Sdk</PackageId>
    <Description>The module contract for onescope: worlds, time and history, a neutral draw list, timeline tracks, pokes and findings. BCL only.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <!-- Every pack is checked against the last published release, so a binary break for a module built on it fails the pack
       instead of being found at load time. The baseline is restored from nuget.org. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
