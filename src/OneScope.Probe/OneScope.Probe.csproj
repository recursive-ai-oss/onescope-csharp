<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(OneScopePackagePrefix).Probe</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).Probe</RootNamespace>
    <PackageId>$(OneScopePackagePrefix).Probe</PackageId>
    <Description>A probe a host program calls to stream a library's replay records to a viewer. BCL only; costs one branch per call when nothing is connected.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Every pack is checked against the first preview, so a binary break for a module built on it is listed (and justified in
       CompatibilitySuppressions.xml) rather than found at load time. The baseline comes from the local feed in ONESCOPE_FEEDS. -->
  <PropertyGroup Condition="'$(ONESCOPE_FEEDS)' != ''">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.1</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
