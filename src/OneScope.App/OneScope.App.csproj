<Project>
  <Import Project="Sdk.props" Sdk="RecursiveAI.OneGame.Sdk" Version="1.23.0" />
  <PropertyGroup>
    <AssemblyName>onescope</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).App</RootNamespace>
    <!-- The shell is a development tool: it always carries onegame's live control and capture operations. -->
    <OneGameDev>true</OneGameDev>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onescope</ToolCommandName>
    <PackageId>$(OneScopePackagePrefix).Tool</PackageId>
    <Description>onescope: a viewer for the Recursive AI family's deterministic libraries. Scrub a replay, inspect any entity, capture frames, and drive it all over MCP.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="fonts\NotoSans-Regular.ttf" LogicalName="NotoSans-Regular.ttf" />
    <None Include="fonts\OFL.txt" Pack="true" PackagePath="" />
    <PackageReference Include="RecursiveAI.OnePhysics.Scope" />
    <ProjectReference Include="..\OneScope.Sdk\OneScope.Sdk.csproj" />
    <ProjectReference Include="..\OneScope.Attach\OneScope.Attach.csproj" />
    <ProjectReference Include="..\OneScope.Probe\OneScope.Probe.csproj" />
    <InternalsVisibleTo Include="OneScope.App.Tests" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="RecursiveAI.OneGame.Sdk" Version="1.23.0" />
  <!-- After the SDK's own settings: the app runs on CoreCLR because it loads modules by reflection, so it is not trimmed or compiled ahead of time. -->
  <PropertyGroup>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>
</Project>
