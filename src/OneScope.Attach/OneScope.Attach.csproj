<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(OneScopePackagePrefix).Attach</AssemblyName>
    <RootNamespace>$(OneScopeRootNamespace).Attach</RootNamespace>
    <PackageId>$(OneScopePackagePrefix).Attach</PackageId>
    <Description>The viewer side of a probe (list running programs, connect, re-simulate a live stream locally) and the .oscope session file. BCL only.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <!-- Every pack is checked against the last published release, so a binary break for a module built on it fails the pack
       instead of being found at load time. The baseline is restored from nuget.org. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OneScope.Sdk\OneScope.Sdk.csproj" />
    <ProjectReference Include="..\OneScope.Probe\OneScope.Probe.csproj" />
  </ItemGroup>
</Project>
