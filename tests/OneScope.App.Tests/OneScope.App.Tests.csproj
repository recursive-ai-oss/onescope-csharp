<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(OneScopeRootNamespace).App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RecursiveAI.OnePhysics" />
    <PackageReference Include="RecursiveAI.OnePath" />
    <PackageReference Include="RecursiveAI.OnePath.Scope" />
    <ProjectReference Include="..\..\src\OneScope.App\OneScope.App.csproj" />
    <ProjectReference Include="..\..\src\OneScope.Sdk\OneScope.Sdk.csproj" />
    <ProjectReference Include="..\..\src\OneScope.Probe\OneScope.Probe.csproj" />
    <ProjectReference Include="..\OneScope.TestModule\OneScope.TestModule.csproj" />
    <!-- Other builds of modules, loaded from folders by the compare tests; built, not referenced. -->
    <ProjectReference Include="..\OneScope.TestModule.RuleB\OneScope.TestModule.RuleB.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PhysicsModuleA\PhysicsModuleA.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PhysicsModuleB\PhysicsModuleB.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyModuleBuilds" AfterTargets="Build">
    <ItemGroup>
      <RuleBFiles Include="$(OneScopeArtifacts)bin/OneScope.TestModule.RuleB/$(Configuration)/$(TargetFramework)/*" />
      <PhysicsAFiles Include="$(OneScopeArtifacts)bin/PhysicsModuleA/$(Configuration)/$(TargetFramework)/*" />
      <PhysicsBFiles Include="$(OneScopeArtifacts)bin/PhysicsModuleB/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)OneScope.TestModule.dll" DestinationFolder="$(OutDir)modules/test-rule-a" />
    <Copy SourceFiles="@(RuleBFiles)" DestinationFolder="$(OutDir)modules/test-rule-b" />
    <Copy SourceFiles="@(PhysicsAFiles)" DestinationFolder="$(OutDir)modules/physics-a" />
    <Copy SourceFiles="@(PhysicsBFiles)" DestinationFolder="$(OutDir)modules/physics-b" />
  </Target>
  <ItemGroup>
    <None Include="..\..\testdata\physics-*.*" Link="testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\testdata\path-*.*" Link="testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\testdata\combo-*.*" Link="testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\testdata\*.ostm" Link="testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\testdata\*.ospc" Link="testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="goldens\*.png" Link="goldens\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
